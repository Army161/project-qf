# Launchpad server settings (deploy/RUNBOOK.md). This file holds NAMES and safe defaults only. Put real values in your
# host's settings; anything marked SECRET goes in the host's secret store, never in Git, chat, logs or this file.
# A setting left out uses the default shown.

# Which network: mainnet-beta (read-only: no key, every launch/trade/claim refused) or devnet (test launchpad, valueless tokens)
QF_CLUSTER=mainnet-beta

# RPC providers. SECRET when the URL carries an API key, as most paid plans do (Helius, Triton, QuickNode...).
# Default: the public endpoint of the network, which is rate-limited and not meant for production traffic.
# QF_RPC_URL=https://<provider A URL>
# A second, independent provider. Every decision read is compared across both; without it mainnet checks say
# SINGLE_PROVIDER, never MATCH.
# QF_RPC_URL_2=https://<provider B URL>

# HTTP server (the image already sets these)
QF_LP_HOST=0.0.0.0
QF_LP_PORT=8080
QF_STATIC_DIR=/app/apps/web/dist

# Database on the persistent volume. One database per network: a mainnet database refuses to open as devnet and back.
QF_LP_DB=/data/qf-launchpad-mainnet.sqlite
# devnet: QF_LP_DB=/data/qf-launchpad-devnet.sqlite

# The public https address people use. Devnet writes it into new coins' on-chain metadata links, so set it before the
# first devnet launch on this host.
# QF_PUBLIC_BASE_URL=https://<your domain>

# Per-person rate limits need the client address the host's proxy passes on.
# Fly.io: fly-client-ip. Render: check one request's headers first (deploy/RUNBOOK.md); leave unset until then.
# QF_CLIENT_IP_HEADER=fly-client-ip

# devnet only: the throwaway operator key is generated on first start at /data/.qf-devnet/operator.json (mode 0600; the
# image sets HOME=/data). To put it elsewhere, set QF_DEVNET_KEY to a file path on the volume.
