{
  "name": "project-qf",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"packages/*/test/**/*.test.ts\" \"tools/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "build:web": "pnpm --filter @project-qf/web build",
    "boundary": "node tools/boundary/check-browser-boundary.ts",
    "license:check": "node tools/license-check/check-licenses.ts",
    "sbom": "node tools/deps/sbom.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  }
}
